function countdown(n)
    for i = n, 1, -1 do
        print(i)
    end
end
countdown(3)
<PROGRAM END>


function f()
    local a = {}
    for i = 1, 20 do
        a[i] = function () return i end
    end

    return a
end

for k in pairs(f()) do print(k) end


function newCounter()
    local n = 0;
    return function() n = n + 1 ; return n end
end

c1 = newCounter(); c2 = newCounter(); 

print(c1()); -- 1
print(c1()); -- 2
print(c2()); -- 1




