-- Simple if-else statement in Lua
score = 85

if score >= 90 then
    print("Grade: A")
elseif score >= 80 then
    print("Grade: B")
elseif score >= 70 then
    print("Grade: C")
else
    print("Grade: D")
end

<PROGRAM END>


-- if-else if-else
if score >= 90 then
    print("A")
else if score < 65 then
        print("B")
   else
      print("C")
   end
end

