function factorial(n)
    if n == 0 then
        return 1
    else
        return n * factorial(n - 1)
    end
end
print(factorial(5))
<PROGRAM END>


local function factorial(n, result = 1):
    if (not n or n < 0) then return nil; else
        local function innerFactorial(n2)
            if not n2 or n2 <= 0 then return nil; else
                return n2 * innerFactorial(n2 - 1); end
        end
        for i = n, 1 do result *= innerFactorial(i); end
        return result
    end
end

