-- While loop in Lua
local count = 1
local sum = 0

while count <= 5 do
    sum = sum + count
    count = count + 1
end

print("The sum of numbers from 1 to 5 is " .. sum)  -- Output: The sum of numbers from 1 to 5 is 15

<PROGRAM END>


-- For Loop in Lua
local sum = 0
  for i=1,4 do
  	sum = sum +i;
   end
   print(sum);	-- Output : 8




